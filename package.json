{
  "name": "@recitt/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "serve:client": "npx nx serve client --proxy-config=apps/client/proxy.conf.json",
    "test:client": "nx test client",
    "test:client-coverage": "nx test client --coverage",
    "serve:api": "npx nx serve api",
    "test:api": "nx test api",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:reset": "docker compose down -v && docker compose up -d",
    "prepare": "husky",
    "format:check": "prettier --check .",
    "format:fix": "   ",
    "lint:all": "nx run-many --target=lint --all",
    "fix:all": "npm run format:fix && npm run lint:all -- --fix"
  },
  "lint-staged": {
    "*.{ts,js,jsx,tsx,json,css,scss,md,html,yml}": [
      "prettier --write"
    ],
    "*.spec.ts": [
      "npx nx affected --target=test --base=HEAD~1 --head=HEAD --parallel=1"
    ]
  },
  "private": true,
