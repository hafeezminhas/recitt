{
  "extends": "../../tsconfig.base.json",
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      // --------------- Library paths ---------------
      "@recitt/types": ["../../libs/types/src/index.ts"],
      // --------------- App paths ---------------
      "@common/*": ["src/app/common/*"],
      "@database/*": ["src/app/database/*"],
      "@dto/*": ["src/app/dto/*"],
      "@shared/*": ["src/app/shared/*"],
      "@types/*": ["src/app/types/*"],
      // --------------- Feature-based paths ---------------
      "@features/*": ["src/app/features/*"],
      "@auth/*": ["src/app/features/auth/*"],
      "@account/*": ["src/app/features/account/*"]
    }
  }
}
