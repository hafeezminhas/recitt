##################################################
# 1. APPLICATION & ENVIRONMENT CONFIG
##################################################
# Environment settings: 'development', 'production', 'test'
NODE_ENV=development

# API Information
API_NAME=Recitt Server
API_VERSION=1.0
API_PORT=3000
API_HOST=localhost
GLOBAL_API_PREFIX=api

# Authentication Information
JWT_KEY=apiKey
JWT_SECRET=440aeef96d24f81f6ab56e7a440db0c845fbd74e0393f79924f59b364d19dc2d
JWT_EXPIRATION=1h
JWT_ISSUER=Exprense Tracker
JWT_AUDIENCE=Exprense Tracker
FAILED_LOGINS_ATTEMPTS=3
ACCOUNT_LOCK_DURATION_HOURS=3

# User Account Management
ACCOUNT_ACTIVATION_TOKEN_KEY=activationKey
ACCOUNT_ACTIVATION_TOKEN_SECRET=d1b2c3e4f5g6h7i8j9k0l1m2n3o4p5q6r7s8t9u0v1w2x3y4z5a6b7c8d9e0f1g2
ACCOUNT_ACTIVATION_TOKEN_EXPIRY=10m


##################################################
# 2. DATABASE CONFIG (Used by your Data Access Library)
##################################################
# Database Type (e.g., postgres, mysql, sqlite)
DB_TYPE=postgres

# Connection Details
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=reccitt_db

# TypeORM Setting: Set to 'true' in development only!
# It automatically applies changes to the DB schema (dangerous in production).
DB_SYNCHRONIZE=true

##################################################
# 3. SWAGGER (API Documentation) CONFIG
##################################################
# Swagger should only be enabled in development or staging environments
SWAGGER_ENABLED=true
SWAGGER_TITLE="Nx Monorepo API"
SWAGGER_DESCRIPTION="API Documentation for the NestJS Backend"
SWAGGER_VERSION=1.0
